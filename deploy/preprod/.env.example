# Required: tag copied from the preproduction GitHub Actions summary. Never latest.
PREPROD_IMAGE=
# Required: exact public origin, e.g. https://<your-test-subdomain> (no path).
PREPROD_APP_ORIGIN=
# Required: Docker network already used by the reachable Newt/Traefik connector.
PREPROD_PROXY_NETWORK=

# Required: NEW independent secrets, not production credentials. Keep out of Git.
# DB >= 24 characters; account passwords >= 12. No $ interpolation: prefer random hex.
# Dockhand: supply these as stack environment variables (Compose environment secrets).
PREPROD_DB_PASSWORD=
PREPROD_ADMIN_PASSWORD=
PREPROD_USER_PASSWORD=

# Required: test area near the phone; copy only public map settings, never production data.
PREPROD_TERRITORY=
PREPROD_POSTAL_CODE=
PREPROD_LATITUDE=
PREPROD_LONGITUDE=
PREPROD_TIMEZONE=Europe/Paris

PREPROD_MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json
PREPROD_ORS_BASE_URL=https://api.heigit.org/openrouteservice
# Hosted ORS requires a server-side key; use a separate test key.
PREPROD_ORS_API_KEY=
# SMTP deliberately has no configurable credentials in this stack.
