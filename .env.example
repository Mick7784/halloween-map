# Generate a long random password; do not commit .env.
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://halloween:replace-with-a-long-random-password@localhost:5432/halloween
APP_PORT=3000
APP_ORIGIN=http://localhost:3000
# Set true when the browser accesses the app through HTTPS.
COOKIE_SECURE=false
# Optional advanced override; normally leave empty. A one-use setup link is logged by migrate.
SETUP_TOKEN=
# Optional synthetic seed, disabled by default. Password required for seed.
DEMO_PASSWORD=
MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json

# SMTP is required to verify new accounts and activate invitations.
# No SMTP: identity messages and campaigns stay pending; new participation cannot be finalized.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# true = implicit TLS, usually port 465; false = STARTTLS, usually port 587.
SMTP_SECURE=false
