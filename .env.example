# Generate a long random password; do not commit .env.
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://halloween:replace-with-a-long-random-password@localhost:5432/halloween
APP_PORT=3000
APP_ORIGIN=http://localhost:3000
# Set true when the browser accesses the app through HTTPS.
COOKIE_SECURE=false
# Protects the first-run wizard. Generate with: openssl rand -hex 32
SETUP_TOKEN=replace-with-a-random-setup-token
# Optional synthetic seed, disabled by default. Password required for seed.
DEMO_PASSWORD=
MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json
